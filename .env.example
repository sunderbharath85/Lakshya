# Copy to .env and fill in what you need. Every value is optional for the local setup (compose.yaml).

# ---- Agent credentials (or log in inside the container instead; see README) ----
# Claude Code: an API key, or a subscription token from `claude setup-token`.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Codex: an API key. For a ChatGPT plan: docker compose exec lakshya codex login --device-auth
OPENAI_API_KEY=

# Identity for commits the agents make.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# ---- Where the agents' code lives (one folder per team inside it) ----
# Local setup: ./workspace by default. Server setup: a Docker volume by default, which is what you want
# on Dokploy (it re-clones the repo folder on every deploy).
LAKSHYA_WORKSPACE=

# ---- Port ----
# Local setup: http://localhost:4777 (only reachable from this machine).
# Server setup with docker/compose.port.yaml: Caddy's port, default 8080.
LAKSHYA_PORT=

# =====================================================================================================
# Server setup only (compose.server.yaml): basic auth, domain, public address.
# =====================================================================================================

# Required by compose.server.yaml, which refuses to start without it.
LAKSHYA_USER=admin
LAKSHYA_PASSWORD=

# HTTPS with an automatic certificate: set a domain that points at this host and add
# -f docker/compose.https.yaml. Leave as :8080 behind a platform proxy (Dokploy) or with compose.port.yaml.
LAKSHYA_SITE=:8080
# The address outside A2A clients use; it goes into the agent cards.
LAKSHYA_PUBLIC_URL=
# With docker/compose.port.yaml: 127.0.0.1 keeps it on this host; 0.0.0.0 opens it to the network (plain HTTP).
LAKSHYA_BIND=127.0.0.1
