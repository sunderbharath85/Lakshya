# Copy to .env and fill in. `docker compose up` refuses to start without LAKSHYA_PASSWORD.

# ---- Basic auth (Caddy) ----
LAKSHYA_USER=admin
LAKSHYA_PASSWORD=

# ---- Where it listens ----
# Local only by default. To reach it from other machines set LAKSHYA_BIND=0.0.0.0, and use a domain below.
LAKSHYA_BIND=127.0.0.1
LAKSHYA_PORT=8080
# Serve HTTPS with an automatic certificate: set a domain that points at this host, and publish
# ports 80/443 (docker compose -f compose.yaml -f docker/compose.https.yaml up -d).
LAKSHYA_SITE=:8080
# The address outside A2A clients use; it goes into the agent cards.
LAKSHYA_PUBLIC_URL=http://localhost:8080

# ---- Where the agents' code lives on this machine ----
# On Dokploy use ../files/workspace: it re-clones the repo on every deploy, and ../files is what it keeps.
LAKSHYA_WORKSPACE=./workspace

# ---- Agent credentials (all optional; you can also log in inside the container) ----
# Claude Code: an API key, or a subscription token from `claude setup-token`.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Codex: an API key. For a ChatGPT plan: docker compose exec lakshya codex login --device-auth
OPENAI_API_KEY=

# Identity for commits the agents make.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
